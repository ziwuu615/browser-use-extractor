# 复制本文件为 .env，填入真实 Key。

# ---- 文本模型（DOM 模式，默认，便宜）----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- 多模态 VLM（视觉模式 --vision，看页面截图）----
# 二选一：通义 Qwen-VL 或 智谱 GLM-4V，均国内直连、OpenAI 兼容。
QWEN_API_KEY=
QWEN_VL_MODEL=qwen-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

GLM_API_KEY=
GLM_MODEL=glm-4v-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 浏览器 ----
HEADLESS=true                 # true 无头；false 有头（本地调试，能看到浏览器操作）
BROWSER_USE_SCREENSHOT=false  # 默认关闭视觉；也可用 --vision 参数临时开启
MAX_CONCURRENCY=3             # 并发上限：同时最多开几个浏览器实例（FastAPI 并发时防资源耗尽）
