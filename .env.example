# 复制本文件为 .env，填入真实 Key。

# ---- 文本模型（DOM 模式，默认，便宜）----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- 多模态 VLM（视觉模式 --vision，看页面截图）----
# 二选一：通义 Qwen-VL 或 智谱 GLM-4V，均国内直连、OpenAI 兼容。
QWEN_API_KEY=
QWEN_VL_MODEL=qwen-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

GLM_API_KEY=
GLM_MODEL=glm-4v-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 浏览器 ----
HEADLESS=true                 # true 无头；false 有头（本地调试，能看到浏览器操作）
BROWSER_USE_SCREENSHOT=false  # 默认关闭视觉；也可用 --vision 参数临时开启
MAX_CONCURRENCY=3             # 并发上限：同时最多开几个浏览器实例（FastAPI 并发时防资源耗尽）

# ---- 数据落库（采集结果持久化、去重）----
STORE_PATH=data/store.sqlite

# ---- 服务鉴权（生产化；留空则不启用鉴权）----
API_KEY=

# ---- 反爬与合规 ----
ROBOTS_CHECK=true             # 采集前检查 robots.txt（合规底线，默认开）
HUMANIZE=true                 # 行为拟人化（动作间随机延迟）
HUMANIZE_DELAY_MIN=0.5        # 动作间延迟下限（秒）
HUMANIZE_DELAY_MAX=2.0        # 动作间延迟上限（秒）
RATE_LIMIT_INTERVAL=2.0       # 同域名两次采集最小间隔（秒）
USER_AGENT=                   # 自定义 User-Agent（留空用浏览器默认）

# ---- IP 代理池（三选一；留空则不启用代理）----
PROXY=                        # 单代理，如 http://127.0.0.1:7890
PROXY_POOL=                   # 多代理逗号分隔，如 http://user:pass@1.1.1.1:8080,socks5://2.2.2.2:1080
PROXY_FILE=                   # 代理文件（每行一个，支持 # 注释）
